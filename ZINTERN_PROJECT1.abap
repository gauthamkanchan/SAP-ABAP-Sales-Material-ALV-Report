REPORT ZINTERN_PROJECT1.

TABLES : VBAK, VBAP, MARA, MAKT, MARD.

TYPES : BEGIN OF TY_FINAL,
          VBELN TYPE VBAP-VBELN,
          VBTYP TYPE VBAK-VBTYP,
          POSNR TYPE VBAP-POSNR,
          MATNR TYPE VBAP-MATNR,
          MTART TYPE MARA-MTART,
          WERKS TYPE MARC-WERKS,
          MAKTX TYPE MAKT-MAKTX,
        END OF TY_FINAL.

DATA : IT_FINAL TYPE TABLE OF TY_FINAL,
       WA_FINAL TYPE TY_FINAL.

SELECTION-SCREEN BEGIN OF BLOCK B1 WITH FRAME.
SELECT-OPTIONS : S_VBELN FOR VBAK-VBELN.
SELECTION-SCREEN END OF BLOCK B1.

INITIALIZATION.

AT SELECTION-SCREEN.

  SELECT COUNT(*)
    FROM VBAK
    INTO @DATA(LV_VBELN)
    WHERE VBELN IN @S_VBELN.

  IF SY-SUBRC NE 0.
    MESSAGE 'Sales Document Not Exist' TYPE 'E'.
  ENDIF.

START-OF-SELECTION.

  SELECT VBELN,
         VBTYP
    FROM VBAK
    INTO TABLE @DATA(LT_VBAK)
    WHERE VBELN IN @S_VBELN.

  IF SY-SUBRC = 0 AND LT_VBAK IS NOT INITIAL.

    SELECT VBELN,
           POSNR,
           MATNR
      FROM VBAP
      INTO TABLE @DATA(LT_VBAP)
      FOR ALL ENTRIES IN @LT_VBAK
      WHERE VBELN = @LT_VBAK-VBELN.

    IF SY-SUBRC = 0 AND LT_VBAP IS NOT INITIAL.

      SELECT MATNR,
             MTART
        FROM MARA
        INTO TABLE @DATA(LT_MARA)
        FOR ALL ENTRIES IN @LT_VBAP
        WHERE MATNR = @LT_VBAP-MATNR.

      IF SY-SUBRC = 0 AND LT_MARA IS NOT INITIAL.

        SELECT MATNR,
               WERKS
          FROM MARD
          INTO TABLE @DATA(LT_MARD)
          FOR ALL ENTRIES IN @LT_MARA
          WHERE MATNR = @LT_MARA-MATNR.

        SELECT MATNR,
               MAKTX
          FROM MAKT
          INTO TABLE @DATA(LT_MAKT)
          FOR ALL ENTRIES IN @LT_MARA
          WHERE MATNR = @LT_MARA-MATNR.

      ENDIF.
    ENDIF.
  ENDIF.

LOOP AT LT_VBAK INTO DATA(WA_VBAK).

  READ TABLE LT_VBAP INTO DATA(WA_VBAP)
       WITH KEY VBELN = WA_VBAK-VBELN.

  READ TABLE LT_MARA INTO DATA(WA_MARA)
       WITH KEY MATNR = WA_VBAP-MATNR.

  READ TABLE LT_MARD INTO DATA(WA_MARD)
       WITH KEY MATNR = WA_MARA-MATNR.

  READ TABLE LT_MAKT INTO DATA(WA_MAKT)
       WITH KEY MATNR = WA_MARA-MATNR.

  WA_FINAL-VBELN = WA_VBAK-VBELN.
  WA_FINAL-VBTYP = WA_VBAK-VBTYP.
  WA_FINAL-POSNR = WA_VBAP-POSNR.
  WA_FINAL-MATNR = WA_VBAP-MATNR.
  WA_FINAL-MTART = WA_MARA-MTART.
  WA_FINAL-WERKS = WA_MARD-WERKS.
  WA_FINAL-MAKTX = WA_MAKT-MAKTX.

  APPEND WA_FINAL TO IT_FINAL.

ENDLOOP.

DATA : IT_FCAT TYPE SLIS_T_FIELDCAT_ALV,
       WA_FCAT TYPE SLIS_FIELDCAT_ALV.

WA_FCAT-FIELDNAME = 'VBELN'.
WA_FCAT-COL_POS = '1'.
WA_FCAT-SELTEXT_M = 'Sales Document'.
APPEND WA_FCAT TO IT_FCAT.
CLEAR WA_FCAT.

WA_FCAT-FIELDNAME = 'VBTYP'.
WA_FCAT-COL_POS = '2'.
WA_FCAT-SELTEXT_M = 'Sales DOC TYP'.
APPEND WA_FCAT TO IT_FCAT.
CLEAR WA_FCAT.

WA_FCAT-FIELDNAME = 'POSNR'.
WA_FCAT-COL_POS = '3'.
WA_FCAT-SELTEXT_M = 'Sales Document Item'.
APPEND WA_FCAT TO IT_FCAT.
CLEAR WA_FCAT.

WA_FCAT-FIELDNAME = 'MATNR'.
WA_FCAT-COL_POS = '4'.
WA_FCAT-SELTEXT_M = 'Material No'.
APPEND WA_FCAT TO IT_FCAT.
CLEAR WA_FCAT.

WA_FCAT-FIELDNAME = 'MTART'.
WA_FCAT-COL_POS = '5'.
WA_FCAT-SELTEXT_M = 'MATERIAL TYPE'.
APPEND WA_FCAT TO IT_FCAT.
CLEAR WA_FCAT.

WA_FCAT-FIELDNAME = 'WERKS'.
WA_FCAT-COL_POS = '6'.
WA_FCAT-SELTEXT_M = 'PLANT'.
APPEND WA_FCAT TO IT_FCAT.
CLEAR WA_FCAT.

WA_FCAT-FIELDNAME = 'MAKTX'.
WA_FCAT-COL_POS = '7'.
WA_FCAT-SELTEXT_M = 'Material Description'.
APPEND WA_FCAT TO IT_FCAT.
CLEAR WA_FCAT.

CALL FUNCTION 'REUSE_ALV_GRID_DISPLAY'
  EXPORTING
    I_CALLBACK_PROGRAM = SY-CPROG
    IT_FIELDCAT        = IT_FCAT
  TABLES
    T_OUTTAB           = IT_FINAL
  EXCEPTIONS
    PROGRAM_ERROR      = 1
    OTHERS             = 2.

IF SY-SUBRC <> 0.
  "Implement suitable error handling here
ENDIF.